@page "/register"
@inject HttpClient Http
@inject ILogger<Register> Logger
@inject NavigationManager Navigation

<PageTitle>アカウント作成</PageTitle>

<div class="login-container">
    <div class="login-card">
        <h1 class="text-center mb-4">📝 アカウント作成</h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (registrationSuccess)
        {
            <div class="alert alert-success">
                <h4>✅ 登録完了</h4>
                <p>アカウントが作成されました。パスキーを設定することで安全にログインできます。</p>
                <a href="/login" class="btn btn-primary">ログインページへ</a>
            </div>
        }
        else
        {
            <EditForm Model="registerModel" OnValidSubmit="RegisterAccount" FormName="RegisterForm">
                <div class="mb-3">
                    <label for="displayName" class="form-label">表示名</label>
                    <InputText id="displayName" @bind-Value="registerModel.DisplayName"
                               class="form-control" placeholder="山田 太郎" />
                </div>

                <div class="mb-3">
                    <label for="regEmail" class="form-label">メールアドレス</label>
                    <InputText id="regEmail" @bind-Value="registerModel.Email"
                               class="form-control" placeholder="email@example.com" />
                </div>

                <div class="mb-3">
                    <label for="regPassword" class="form-label">パスワード</label>
                    <InputText id="regPassword" type="password" @bind-Value="registerModel.Password"
                               class="form-control" placeholder="8文字以上" />
                    <small class="text-muted">英大文字・小文字・数字・記号を含む8文字以上</small>
                </div>

                <div class="mb-3">
                    <label for="regPasswordConfirm" class="form-label">パスワード確認</label>
                    <InputText id="regPasswordConfirm" type="password"
                               @bind-Value="registerModel.PasswordConfirm"
                               class="form-control" placeholder="パスワードを再入力" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @(isLoading ? "登録中..." : "アカウント作成")
                </button>
            </EditForm>

            <div class="text-center mt-3">
                <a href="/login">ログインはこちら</a>
            </div>
        }
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private bool isLoading = false;
    private bool registrationSuccess = false;
    private string? errorMessage;

    private async Task RegisterAccount()
    {
        if (registerModel.Password != registerModel.PasswordConfirm)
        {
            errorMessage = "パスワードが一致しません";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var request = new HomeLab.Shared.DTOs.RegisterRequest(
                registerModel.Email ?? "",
                registerModel.Password ?? "",
                registerModel.DisplayName ?? "");

            var response = await Http.PostAsJsonAsync("/api/auth/register", request);

            if (response.IsSuccessStatusCode)
            {
                registrationSuccess = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = error.Contains("already registered")
                    ? "このメールアドレスは既に登録されています"
                    : "アカウント作成に失敗しました";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"登録エラー: {ex.Message}";
            Logger.LogError(ex, "Registration failed");
        }
        finally
        {
            isLoading = false;
        }
    }

    private class RegisterModel
    {
        public string? DisplayName { get; set; }
        public string? Email { get; set; }
        public string? Password { get; set; }
        public string? PasswordConfirm { get; set; }
    }
}
