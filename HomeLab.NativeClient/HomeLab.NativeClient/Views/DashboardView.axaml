<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HomeLab.NativeClient.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="HomeLab.NativeClient.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16">
        <!-- ヘッダー -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="デバイス一覧" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="更新" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- デバイスリスト -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Margin="0,0,0,12"
                            BoxShadow="0 2 6 0 #22000000" Padding="16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- ステータスインジケーター -->
                            <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" Margin="0,0,12,0"
                                    Background="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    VerticalAlignment="Center"/>

                            <!-- デバイス情報 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Foreground="#888" FontSize="12">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} | 最終通信: {1:yyyy/MM/dd HH:mm}">
                                            <Binding Path="Status"/>
                                            <Binding Path="LastSeenAt"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <!-- ロック操作ボタン -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="解錠"
                                        Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).UnlockCommand}"
                                        CommandParameter="{Binding Id}"
                                        Background="#2ecc71" Foreground="White"
                                        Width="70" Height="36" CornerRadius="6"
                                        IsVisible="{Binding !IsLocked}"/>
                                <Button Content="施錠"
                                        Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).LockCommand}"
                                        CommandParameter="{Binding Id}"
                                        Background="#e74c3c" Foreground="White"
                                        Width="70" Height="36" CornerRadius="6"
                                        IsVisible="{Binding IsLocked}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
